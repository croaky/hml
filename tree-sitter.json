{
  "grammars": [
    {
      "name": "hml",
      "camelcase": "Hml",
      "scope": "source.hml",
      "path": ".",
      "file-types": ["hml"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "hml grammar for tree-sitter",
    "authors": [{ "name": "Dan Croak" }],
    "links": {
      "repository": "https://github.com/croaky/hml"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "kotlin": false,
    "zig": false
  }
}
